# Значения рассчитаны на запуск приложения и тестов на хосте (make run-api, pytest):
# хосты — localhost, порты — опубликованные из docker-compose.yml.
# Внутри docker compose (make up) хосты и порты переопределяются в docker-compose.yml (x-app.environment).

# =================================
# Настройки приложения
# =================================
APP_DEBUG=true
APP_PORT=8008
# Порт админ-API воркеров (scheduler-процесс)
SCHEDULER_PORT=8009
APP_CORS_ORIGINS=[]

# =================================
# Логирование
# =================================
LOG_LEVEL=INFO

# =================================
# База данных Postgres
# =================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_POOL_SIZE=5

# [if redis]
# =================================
# База данных Redis
# =================================
REDIS_HOST=localhost
# 6378 — порт на хосте (см. docker-compose.yml), внутри compose используется 6379
REDIS_PORT=6378
REDIS_DB=0
# REDIS_PASSWORD=  # Опционально, если Redis защищён паролем

# [endif]
# [if rabbitmq]
# =================================
# Очередь сообщений RabbitMQ
# =================================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_TLS_ENABLED=false
RABBITMQ_CERT_PATH=/certs
# Задержки перед повторами упавшего сообщения (сек), после последней — в <queue>.dlq
RABBITMQ_RETRY_DELAYS=[1,10,60]

# [endif]
# [if kafka]
# =================================
# Очередь сообщений Kafka
# =================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_CLIENT_ID=backend_template
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# KAFKA_SASL_MECHANISM=  # Опционально, напр. PLAIN, SCRAM-SHA-256
# KAFKA_SASL_USERNAME=   # Опционально, если включён SASL
# KAFKA_SASL_PASSWORD=   # Опционально, если включён SASL
KAFKA_AUTO_OFFSET_RESET=latest
# Повторы упавшего сообщения внутри консьюмера (backoff удваивается), затем — в <topic>.dlq
KAFKA_MAX_RETRIES=3
KAFKA_RETRY_BACKOFF=1.0

# [endif]
# [if minio]
# =================================
# Object Storage MinIO
# =================================
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false

# [endif]
# [if messaging]
# =================================
# Публикация событий и outbox
# =================================
# Брокер для IMessagePublisher и outbox relay: rabbitmq | kafka
# [if rabbitmq]
MESSAGING_PUBLISHER=rabbitmq
# [endif]
# [ifc kafka and not rabbitmq]
# MESSAGING_PUBLISHER=kafka
# [endif]
MESSAGING_OUTBOX_BATCH_SIZE=100
MESSAGING_OUTBOX_POLL_INTERVAL=1.0

# [endif]
# =================================
# Трейсинг OpenTelemetry (OTLP/HTTP)
# =================================
OTEL_ENABLED=false
OTEL_SERVICE_NAME=backend_template
# Jaeger из docker compose --profile observability: UI на http://localhost:16686
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
