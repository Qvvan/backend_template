# =================================
# Настройки приложения
# =================================
APP_DEBUG=true
APP_PORT=8008
APP_CORS_ORIGINS=[]

# =================================
# Логирование
# =================================
LOG_LEVEL=INFO

# =================================
# База данных Postgres
# =================================
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DATABASE=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_POOL_SIZE=5

# =================================
# База данных Redis
# =================================
REDIS_HOST=redis
REDIS_PORT=6378
REDIS_DB=0
# REDIS_PASSWORD=  # Опционально, если Redis защищён паролем

# =================================
# Очередь сообщений RabbitMQ
# =================================
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_SSL_CONTEXT=false
RABBITMQ_SERT_PATH=/certs

# =================================
# Object Storage MinIO
# =================================
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false