async def test_writes_publish_events_through_outbox(service: {{ n.pascal }}Service, uow: FakeUnitOfWork) -> None:
    created = await service.create(_entity())
    await service.update(created.id, _changes())
    await service.delete(created.id)
    assert [m.routing_key for m in uow.outbox.messages] == [
        "{{ n.snake }}.created",
        "{{ n.snake }}.updated",
        "{{ n.snake }}.deleted",
    ]
    assert all(m.payload["{{ n.snake }}_id"] == created.id for m in uow.outbox.messages)
