_LOGGER = AppLogger(level="DEBUG")


def _message() -> {{ n.pascal }}Message:
    return {{ n.pascal }}Message({% for f in fields %}{{ f.name }}={{ f.type.sample }}{% if not loop.last %}, {% endif %}{% endfor %})


async def test_handler_maps_message_to_entity() -> None:
    service = AsyncMock(spec=I{{ n.pascal }}Service)
    message = _message()
    await {{ n.pascal }}Handler(service=service, logger=_LOGGER).handle(message)
    service.handle.assert_awaited_once_with(
        {{ n.pascal }}Entity(message_id=message.event_id, {% for f in fields %}{{ f.name }}={{ f.type.sample }}{% if not loop.last %}, {% endif %}{% endfor %})
    )


async def test_service_processes_each_message_once() -> None:
    uow = FakeUnitOfWork()
    service = {{ n.pascal }}Service(uow=uow, logger=_LOGGER)
    event = {{ n.pascal }}Entity(message_id="m-1", {% for f in fields %}{{ f.name }}={{ f.type.sample }}{% if not loop.last %}, {% endif %}{% endfor %})

    await service.handle(event)
    await service.handle(event)  # redelivery

    assert uow.inbox.processed == {("m-1", "{{ n.snake }}")}
    assert uow.commits == 2
