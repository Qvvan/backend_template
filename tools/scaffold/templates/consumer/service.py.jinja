_CONSUMER = "{{ n.snake }}"


class {{ n.pascal }}Service(I{{ n.pascal }}Service):
    """Idempotent consumer: the inbox record and the business change share one transaction."""

    __slots__ = ("_logger", "_uow")

    def __init__(self, uow: IUnitOfWork, logger: AppLogger) -> None:
        self._uow = uow
        self._logger = logger

    async def handle(self, event: {{ n.pascal }}Entity) -> None:
        async with self._uow.begin() as session:
            if not await session.inbox.register(event.message_id, _CONSUMER):
                self._logger.info("Duplicate message skipped", consumer=_CONSUMER, message_id=event.message_id)
                return
